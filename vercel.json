{
  "rewrites": [
    {
      "source": "/admin/api/products/:id",
      "destination": "/api/admin/products?id=:id"
    },
    {
      "source": "/admin/api/users/:id",
      "destination": "/api/admin/users?id=:id"
    },
    {
      "source": "/admin/api/orders/:id/status",
      "destination": "/api/admin/orders?id=:id"
    },
    {
      "source": "/admin/api/:path*",
      "destination": "/api/admin/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
